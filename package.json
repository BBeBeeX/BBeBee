{
  "name": "bbebee",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A plugin-based cross-platform music player. See docs/",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "check:locales": "node packages/feature/plugin-i18n/scripts/check-locales.mjs",
    "check:i18n-gate": "node packages/feature/plugin-i18n/scripts/check-no-hardcoded.mjs",
    "check:changed": "node --experimental-strip-types packages/tooling/tooling-check-changed/src/cli.ts",
    "typecheck": "pnpm -r --no-sort typecheck",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content",
    "lint:fix": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build": "pnpm -r --filter \"./packages/**\" build",
    "dev:desktop": "pnpm --filter @BBeBee/desktop dev",
    "fetch:audio-engine": "node scripts/fetch-audio-engine.mjs",
    "test:audio-engine": "pnpm --filter @BBeBee/desktop test:audio-engine",
    "dev:mobile": "pnpm --filter @BBeBee/mobile start",
    "dev:android": "pnpm --filter @BBeBee/mobile android",
    "build:desktop": "pnpm --filter @BBeBee/desktop build",
    "build:desktop:rust": "cargo build --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "package:desktop": "pnpm --filter @BBeBee/desktop package",
    "dist:desktop": "pnpm --filter @BBeBee/desktop dist",
    "gen:plugins": "node --experimental-strip-types packages/tooling/tooling-gen-plugins/src/cli.ts",
    "build:sources": "node --experimental-strip-types scripts/sources/cli.ts",
    "watch:sources": "node --experimental-strip-types scripts/sources/cli.ts --watch",
    "new:plugin": "node --experimental-strip-types packages/tooling/tooling-create-plugin/src/cli.ts",
    "clean": "node -e \"import('node:fs').then(function(fs){for(const p of fs.globSync('{packages/*/*,packages/*,apps/*}/{dist,out,*.tsbuildinfo}'))fs.rmSync(p,{recursive:true,force:true})})\"",
    "clean:all": "node -e \"import('node:fs').then(function(fs){for(const p of fs.globSync('{.,packages/*/*,packages/*,apps/*}/{dist,out,*.tsbuildinfo,node_modules}'))fs.rmSync(p,{recursive:true,force:true})})\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.11"
  }
}

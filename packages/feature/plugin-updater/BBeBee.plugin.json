{
  "id": "@bbebee/plugin-updater",
  "name": "@bbebee/plugin-updater",
  "displayName": "Updater",
  "description": "Application updates and hot-updates coordinator for desktop and mobile, supporting main/dev channels, GitHub Releases, and semver patch strategies.",
  "version": "0.0.0",
  "author": "BBeBee Team",
  "engines": {
    "BBeBee": "^0.1.0"
  },
  "enabled": true,
  "dependencies": [],
  "systemId": "layer-4",
  "moduleId": "updater",
  "entry": {
    "main": "./dist/index.js"
  },
  "capabilities": [
    "net:host/**",
    "fs:read:all",
    "fs:write:cache",
    "fs:write:downloads",
    "fs:write:own"
  ],
  "contributes": {
    "services": [
      "updater"
    ]
  },
  "effect": "updater"
}

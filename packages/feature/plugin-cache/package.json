{
  "name": "@bbebee/plugin-cache",
  "version": "0.0.0",
  "description": "plugin-cache — serve covers and remote streams from a local cache, fetching only on a miss.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./hooks": "./src/hooks.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@BBeBee/protocol": "workspace:*",
    "@BBeBee/toolkit": "workspace:*",
    "@BBeBee/ui-core": "workspace:*",
    "cordis": "4.0.0-rc.9",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@BBeBee/core-db-node": "workspace:*",
    "@BBeBee/core-fs-node": "workspace:*",
    "@BBeBee/core-paths-node": "workspace:*",
    "@BBeBee/kernel": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react-dom": "19.2.3"
  }
}

{
  "name": "@BBeBee/plugin-player",
  "version": "0.0.0",
  "description": "ctx.player — transport, queue, resolution, history.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./views": "./src/views.ts",
    "./package.json": "./package.json",
    "./hooks": "./src/hooks.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@BBeBee/protocol": "workspace:*",
    "@BBeBee/kernel": "workspace:*",
    "cordis": "4.0.0-rc.9",
    "@BBeBee/toolkit": "workspace:*",
    "@BBeBee/ui-core": "workspace:*",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@BBeBee/core-db-node": "workspace:*",
    "@BBeBee/core-fs-node": "workspace:*",
    "@BBeBee/core-paths-node": "workspace:*",
    "@BBeBee/core-audio-webaudio": "workspace:*",
    "@BBeBee/plugin-sources": "workspace:*",
    "@types/react": "^19.2.0"
  }
}

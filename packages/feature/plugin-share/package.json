{
  "name": "@bbebee/plugin-share",
  "version": "0.0.0",
  "description": "ctx.share — Song, playlist, and lyrics sharing with image steganography.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks.ts",
    "./views": "./src/views.ts",
    "./steganography": "./src/steganography.ts",
    "./metadata": "./src/metadata.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./hooks": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.js"
      },
      "./views": {
        "types": "./dist/views.d.ts",
        "default": "./dist/views.js"
      },
      "./steganography": {
        "types": "./dist/steganography.d.ts",
        "default": "./dist/steganography.js"
      },
      "./metadata": {
        "types": "./dist/metadata.d.ts",
        "default": "./dist/metadata.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@BBeBee/protocol": "workspace:*",
    "@BBeBee/kernel": "workspace:*",
    "cordis": "4.0.0-rc.9",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}

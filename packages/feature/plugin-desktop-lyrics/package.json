{
  "name": "@BBeBee/plugin-desktop-lyrics",
  "version": "0.0.0",
  "description": "plugin-desktop-lyrics — headless state and controls for desktop floating lyrics.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./hooks": "./src/hooks.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./hooks": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@BBeBee/kernel": "workspace:*",
    "@BBeBee/plugin-lyrics": "workspace:*",
    "@BBeBee/protocol": "workspace:*",
    "@BBeBee/toolkit": "workspace:*",
    "cordis": "4.0.0-rc.9",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}

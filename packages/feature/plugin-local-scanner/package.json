{
  "name": "@BBeBee/plugin-local-scanner",
  "version": "0.0.0",
  "description": "ctx.scanner \u2014 the local filesystem walk.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./hooks": "./src/hooks.ts",
    "./views": "./src/views.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@BBeBee/protocol": "workspace:*",
    "@BBeBee/kernel": "workspace:*",
    "cordis": "4.0.0-rc.9",
    "@BBeBee/toolkit": "workspace:*",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@BBeBee/core-codec-node": "workspace:*",
    "@BBeBee/core-db-node": "workspace:*",
    "@BBeBee/core-fs-node": "workspace:*",
    "@BBeBee/core-paths-node": "workspace:*",
    "@BBeBee/plugin-sources": "workspace:*",
    "@BBeBee/tooling-fixtures": "workspace:*",
    "@types/react": "^19.2.0",
    "@BBeBee/plugin-player": "workspace:*"
  }
}

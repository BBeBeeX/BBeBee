{
  "id": "@bbebee/plugin-extension-host",
  "name": "@bbebee/plugin-extension-host",
  "displayName": "Extensions",
  "description": "ctx.extensions — third-party extensions hosted in a ctx.js realm, one fiber and one realm each (M5).",
  "version": "0.0.0",
  "author": "BBeBee Team",
  "engines": {
    "BBeBee": "^0.1.0"
  },
  "enabled": true,
  "dependencies": [],
  "systemId": "layer-4",
  "moduleId": "extensions",
  "platforms": [
    "desktop",
    "mobile"
  ],
  "entry": {
    "main": "./dist/index.js"
  },
  "capabilities": [
    "net:host/*"
  ],
  "contributes": {
    "services": [
      "extensions"
    ]
  },
  "effect": "extensions"
}

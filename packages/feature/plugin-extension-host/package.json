{
  "name": "@bbebee/plugin-extension-host",
  "version": "0.0.0",
  "description": "ctx.extensions — third-party extensions hosted in a ctx.js realm (M5).",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@BBeBee/protocol": "workspace:*",
    "cordis": "4.0.0-rc.9"
  },
  "devDependencies": {
    "@BBeBee/core-fs-node": "workspace:*",
    "@bbebee/core-http-node": "workspace:*",
    "@bbebee/core-js-quickjs-node": "workspace:*",
    "@BBeBee/core-paths-node": "workspace:*",
    "@bbebee/core-store-fs": "workspace:*",
    "@BBeBee/kernel": "workspace:*"
  }
}

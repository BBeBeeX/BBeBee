{
  "name": "@bbebee/core-http-mobile",
  "version": "0.0.0",
  "description": "ctx.http for iOS and Android — the M1 slice over expo/fetch.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bbebee/core-http-desktop": "workspace:*",
    "@BBeBee/kernel": "workspace:*",
    "@BBeBee/protocol": "workspace:*",
    "cordis": "4.0.0-rc.9",
    "expo": "~57.0.18"
  }
}

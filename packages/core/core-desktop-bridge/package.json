{
  "name": "@bbebee/core-desktop-bridge",
  "version": "0.0.0",
  "description": "Renderer-side fs/db services over the desktop IPC bridge, and the sidecar host.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts",
    "./protocol": "./src/protocol.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@BBeBee/protocol": "workspace:*",
    "@BBeBee/kernel": "workspace:*",
    "@bbebee/core-codec-node": "workspace:*",
    "cordis": "4.0.0-rc.9"
  },
  "devDependencies": {
    "@BBeBee/core-paths-node": "workspace:*",
    "@BBeBee/core-fs-node": "workspace:*",
    "@BBeBee/core-db-node": "workspace:*"
  }
}

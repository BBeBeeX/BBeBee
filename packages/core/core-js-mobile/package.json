{
  "name": "@bbebee/core-js-mobile",
  "version": "0.0.0",
  "description": "ctx.js for iOS and Android — a sandboxed pure-JS interpreter realm, since Hermes has no WebAssembly for QuickJS.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@BBeBee/protocol": "workspace:*",
    "@nyariv/sandboxjs": "0.9.7",
    "acorn": "^8.14.0",
    "cordis": "4.0.0-rc.9"
  },
  "devDependencies": {
    "@BBeBee/kernel": "workspace:*"
  }
}

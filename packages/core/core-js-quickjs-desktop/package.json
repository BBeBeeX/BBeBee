{
  "name": "@bbebee/core-js-quickjs-desktop",
  "version": "0.0.0",
  "description": "ctx.js — a QuickJS realm per source, for desktop and Node.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@BBeBee/protocol": "workspace:*",
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "cordis": "4.0.0-rc.9",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@BBeBee/kernel": "workspace:*"
  }
}

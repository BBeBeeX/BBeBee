{
  "name": "@BBeBee/core-audio-mpv",
  "version": "0.0.0",
  "description": "ctx.audio — libmpv audio engine with native audio-engine crash isolation, direct WASAPI output, native DSP/EQ, and FFT visualizer.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/fake-context.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/fake-context.d.ts",
        "default": "./dist/fake-context.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@BBeBee/protocol": "workspace:*",
    "@BBeBee/kernel": "workspace:*",
    "cordis": "4.0.0-rc.9"
  }
}

{
  "name": "@bbebee/core-device-mobile",
  "version": "0.0.0",
  "description": "ctx.device for iOS and Android — network, battery, locale.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@BBeBee/protocol": "workspace:*",
    "cordis": "4.0.0-rc.9",
    "expo-application": "~57.0.2",
    "expo-battery": "~57.0.2",
    "expo-network": "~57.0.1",
    "react-native": "0.86.3"
  }
}

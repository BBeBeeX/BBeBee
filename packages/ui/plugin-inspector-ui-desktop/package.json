{
  "name": "@BBeBee/plugin-inspector-ui-desktop",
  "version": "0.0.0",
  "description": "React DOM view for the Cordis Plugin Topology Explorer.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.tsx",
    "./package.json": "./package.json"
  },
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@BBeBee/kernel": "workspace:*",
    "@BBeBee/plugin-inspector": "workspace:*",
    "@BBeBee/protocol": "workspace:*",
    "@BBeBee/ui-kit-desktop": "workspace:*",
    "cordis": "4.0.0-rc.9",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react-dom": "19.2.3",
    "vitest": "^4.1.11"
  }
}

link-workspace-packages=true
strict-dep-builds=false
# `pnpm -r` runs topologically sorted but only 4 workers wide by default;
# `pnpm typecheck` is CPU-bound (~10 CPU-minutes of tsc across ~90 packages)
# and was pinned at that ceiling. Ordering — which is what correctness needs
# for build — is untouched; this only widens the fan-out.
workspace-concurrency=8
# Run package.json scripts in pnpm's built-in POSIX shell interpreter so
# commands work identically on Windows, Linux, and macOS.
shell-emulator=true
